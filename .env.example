# Claves de IA. También puedes guardarlas desde la app: quedan en la base local.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# https://build.nvidia.com
NVIDIA_API_KEY=

# Modelos (opcional)
OPENROUTER_MODEL=openrouter/auto
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Ruta opcional de la base local.
# Por defecto: ~/.local/share/atiendo/atiendo.json
# ATIENDO_DB_PATH=
